# =============================================================
# Indian Investment Research Wizard — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------ LLM ------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------ Database ------
POSTGRES_URL=postgresql://user:password@localhost:5432/investment_agent
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ------ Trading Mode ------
# Set to "true" for paper trading (safe default), "false" for live trading
PAPER_TRADING=true

# ------ Broker APIs (fill only the one you use) ------

# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Upstox API v2
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_ID=

# DhanHQ
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ------ News ------
NEWS_API_KEY=your_newsapi_key_here

# ------ App ------
LOG_LEVEL=INFO
